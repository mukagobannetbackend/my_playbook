# Required in production: unique, stable, random application session key (32+ random bytes).
TRADEVAULT_SECRET_KEY=
TRADEVAULT_ENV=production
PORT=3000

# Public HTTPS origin used to build one-time password-recovery links.
APP_BASE_URL=https://your-public-app.example

# SMTP provider credentials: configure a verified sender with your mail provider.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PASSWORD_RESET_MINUTES=60

# Managed WebDev supplies DATABASE_URL, MANUS_API_URL and MANUS_API_KEY at runtime.
# These blank lines are documentation/placeholders only. Never commit their real values.
DATABASE_URL=
MANUS_API_URL=
MANUS_API_KEY=
# For a local-only run, leave these unset: SQLite and local screenshot files are used.
LOCAL_STORAGE_ENABLED=true
LOCAL_UPLOAD_FOLDER=instance/uploads
SIMILARITY_DISTANCE=10
TRADEVAULT_COOKIE_SECURE=true
# Optional comma-separated host allow-list (if you enable Flask TRUSTED_HOSTS enforcement).
TRADEVAULT_TRUSTED_HOSTS=
